digraph "uml_dominio" {
rankdir=TB; nodesep=0.55; ranksep=0.7; splines=true; compound=true;
node [shape=plaintext fontname="Helvetica" fontsize=10]; edge [fontname="Helvetica" fontsize=9 labeldistance=1.6];
subgraph cluster_clients { label="clients"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"cliente" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String  «CLI-001»<BR ALIGN="LEFT"/>nombre: String<BR ALIGN="LEFT"/>correo: String  «restringido»<BR ALIGN="LEFT"/>telefono: String  «restringido»<BR ALIGN="LEFT"/>creado: DateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
subgraph cluster_auth { label="auth"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"usuario" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String<BR ALIGN="LEFT"/>username: String<BR ALIGN="LEFT"/>claveHash: Bytes  «scrypt+sal»<BR ALIGN="LEFT"/>roles: Set&lt;Rol&gt;<BR ALIGN="LEFT"/>activo: Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"sesion" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Sesion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tokenHash: String  «sha256»<BR ALIGN="LEFT"/>expira: DateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
subgraph cluster_inventory { label="inventory"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"producto" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Producto</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: Int<BR ALIGN="LEFT"/>nombre: String<BR ALIGN="LEFT"/>categoria: Categoria<BR ALIGN="LEFT"/>precio: Int<BR ALIGN="LEFT"/>activo: Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"stock" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Stock</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enMano: Int<BR ALIGN="LEFT"/>reservado: Int<BR ALIGN="LEFT"/>«enMano &gt;= reservado &gt;= 0»<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"promo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Promocion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: Int<BR ALIGN="LEFT"/>tipo: «2x1»<BR ALIGN="LEFT"/>etiqueta: String<BR ALIGN="LEFT"/>activa: Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"reserva" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Reserva</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">pedidoId: String<BR ALIGN="LEFT"/>cantidad: Int<BR ALIGN="LEFT"/>precioUnitario: Int<BR ALIGN="LEFT"/>descuento: Int<BR ALIGN="LEFT"/>estado: reservada|confirmada|liberada<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
subgraph cluster_orders { label="orders"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"pedido" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Pedido</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String  «ORD-XXXXXXXX»<BR ALIGN="LEFT"/>clienteId: String<BR ALIGN="LEFT"/>estado: EstadoPedido<BR ALIGN="LEFT"/>subtotal: Int<BR ALIGN="LEFT"/>descuento: Int<BR ALIGN="LEFT"/>total: Int  «subtotal - descuento»<BR ALIGN="LEFT"/>notas: String(&lt;=200)<BR ALIGN="LEFT"/>stockLiberado: Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"detalle" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>DetallePedido</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">productoId: Int<BR ALIGN="LEFT"/>nombre: String  «copia»<BR ALIGN="LEFT"/>precioUnitario: Int  «copia»<BR ALIGN="LEFT"/>cantidad: Int(1..20)<BR ALIGN="LEFT"/>descuento: Int<BR ALIGN="LEFT"/>promo: String?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"evped" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>EventoPedido</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">evento: creado|pagado|estado|cancelado|expirado<BR ALIGN="LEFT"/>fecha: DateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
subgraph cluster_payments { label="payments"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"pago" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>Pago</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String<BR ALIGN="LEFT"/>pedidoId: String<BR ALIGN="LEFT"/>monto: Int<BR ALIGN="LEFT"/>estado: pending|succeeded|failed|requires_refund<BR ALIGN="LEFT"/>refProveedor: String<BR ALIGN="LEFT"/>claveIdempotencia: String<BR ALIGN="LEFT"/>ordenSincronizada: Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"evweb" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>EventoWebhook</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">eventoId: String  «unico»<BR ALIGN="LEFT"/>tipo: String<BR ALIGN="LEFT"/>recibido: DateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
subgraph cluster_analytics { label="analytics"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"hecho" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#B8860B"><TR><TD BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>HechoVenta</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">pedidoId: String<BR ALIGN="LEFT"/>productoId: Int<BR ALIGN="LEFT"/>cantidad: Int<BR ALIGN="LEFT"/>monto: Int<BR ALIGN="LEFT"/>fecha: DateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
subgraph cluster_svc { label="Servicios publicos (estereotipo service)"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10; labeljust=l;
"s_auth" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«service»</FONT><BR/><B>AuthService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+registrar(RegistroDTO): UsuarioDTO   S01<BR ALIGN="LEFT"/>+ingresar(Credenciales): SesionDTO   S02<BR ALIGN="LEFT"/>+salir(): void   S03<BR ALIGN="LEFT"/>+identidadActual(): IdentidadDTO   S33<BR ALIGN="LEFT"/>+introspectar(token): IdentidadDTO   (interno)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"s_cat" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«service»</FONT><BR/><B>CatalogService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+consultarCatalogo(filtro): ProductoDTO[]   S04<BR ALIGN="LEFT"/>+obtenerProducto(id): ProductoDTO   S05<BR ALIGN="LEFT"/>+crearProducto(ProductoIn): ProductoDTO   S06<BR ALIGN="LEFT"/>+modificarProducto(id, cambios): ProductoDTO   S07<BR ALIGN="LEFT"/>+desactivarProducto(id): void   S08<BR ALIGN="LEFT"/>+consultarStock(): StockDTO[]   S09<BR ALIGN="LEFT"/>+ajustarStock(id, delta, motivo): StockDTO   S10<BR ALIGN="LEFT"/>+consultarPromociones(): PromocionDTO[]   S34<BR ALIGN="LEFT"/>+activarPromocion(id, activa): PromocionDTO   S35<BR ALIGN="LEFT"/>+reservar / liberar / confirmar   (interno)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"s_cli" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«service»</FONT><BR/><B>ClientService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+listarClientes(): ClienteDTO[]   S11<BR ALIGN="LEFT"/>+obtenerCliente(id): ClienteDTO   S12<BR ALIGN="LEFT"/>+crearCliente(ClienteIn): ClienteDTO   S13<BR ALIGN="LEFT"/>+modificarCliente(id, cambios): ClienteDTO   S14<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"s_ord" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«service»</FONT><BR/><B>OrderService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+crearPedido(PedidoIn): PedidoDTO   S15<BR ALIGN="LEFT"/>+consultarPedidos(filtro): PedidoDTO[]   S16<BR ALIGN="LEFT"/>+consultarPedido(id): PedidoDTO   S17<BR ALIGN="LEFT"/>+anularPedido(id): AnulacionDTO   S18<BR ALIGN="LEFT"/>+avanzarEstado(id, estado): PedidoDTO   S19<BR ALIGN="LEFT"/>+expirarPendientes(): Id[]   S20<BR ALIGN="LEFT"/>+conciliarStock(): ResultadoDTO   S21<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"s_pay" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«service»</FONT><BR/><B>PaymentService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+iniciarPago(PagoIn): PagoDTO   S22<BR ALIGN="LEFT"/>+recibirNotificacion(Evento): ResultadoDTO   S23<BR ALIGN="LEFT"/>+consultarPago(id): PagoDTO   S24<BR ALIGN="LEFT"/>+listarPagos(filtro): PagoDTO[]   S25<BR ALIGN="LEFT"/>+conciliarPagos(): ResultadoDTO   S26<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"s_ana" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«service gRPC»</FONT><BR/><B>AnalyticsService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+sincronizar(): int   S27<BR ALIGN="LEFT"/>+resumenVentas(dias, top): ResumenDTO   S28<BR ALIGN="LEFT"/>+transmitirVentas(desde): stream HechoVentaDTO   S29<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"s_gql" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#4F8A3B"><TR><TD BGCOLOR="#D5E8D4" ALIGN="CENTER"><FONT POINT-SIZE="8">«service»</FONT><BR/><B>GraphQLGateway</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+myOrders / order / products / product / me   S30<BR ALIGN="LEFT"/>+createOrder   S31<BR ALIGN="LEFT"/>+salesSummary / syncAnalytics   S32<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
"cliente" -> "usuario" [label="tiene acceso", taillabel="1", headlabel="0..1", arrowhead=none];
"usuario" -> "sesion" [label="abre", taillabel="1", headlabel="0..*", dir=both, arrowtail=diamond, arrowhead=none];
"cliente" -> "pedido" [label="realiza", taillabel="1", headlabel="0..*", arrowhead=none];
"pedido" -> "detalle" [label="contiene", taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond, arrowhead=none];
"pedido" -> "evped" [label="registra", taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond, arrowhead=none];
"producto" -> "stock" [label="tiene", taillabel="1", headlabel="1", dir=both, arrowtail=diamond, arrowhead=none];
"producto" -> "promo" [label="en promocion", taillabel="1", headlabel="0..1", arrowhead=none];
"producto" -> "detalle" [label="copiado en", taillabel="1", headlabel="0..*", arrowhead=none];
"pedido" -> "reserva" [label="reserva stock", taillabel="1", headlabel="1..*", arrowhead=none];
"reserva" -> "producto" [label="de", taillabel="0..*", headlabel="1", arrowhead=none];
"pedido" -> "pago" [label="se paga con", taillabel="1", headlabel="0..*", arrowhead=none];
"pago" -> "evweb" [label="recibe", taillabel="1", headlabel="0..*", dir=both, arrowtail=diamond, arrowhead=none];
"pedido" -> "hecho" [label="origina", taillabel="1", headlabel="0..*", arrowhead=none];
"s_auth" -> "usuario" [style=dashed, arrowhead=vee];
"s_cat" -> "producto" [style=dashed, arrowhead=vee];
"s_cli" -> "cliente" [style=dashed, arrowhead=vee];
"s_ord" -> "pedido" [style=dashed, arrowhead=vee];
"s_pay" -> "pago" [style=dashed, arrowhead=vee];
"s_ana" -> "hecho" [style=dashed, arrowhead=vee];
}