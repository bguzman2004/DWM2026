<mxfile host="app.diagrams.net"><diagram name="UML API Gateway, politicas y GraphQL Gateway" id="uml_gateway"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1302" pageHeight="1076" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:9px&quot;&gt;«gateway»&lt;/span&gt;&lt;br&gt;&lt;b&gt;ApiGateway&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;cookie: session_token  «HttpOnly, SameSite=Lax»&lt;br&gt;maxBody: 64 KiB&lt;br&gt;timeout: 3 s&lt;hr size=&quot;1&quot;&gt;+handle(request): Response&lt;br&gt;+login() / logout() / register() / me()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#DAE8FC;strokeColor=#3B6EA8;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="626" y="-0" width="252" height="102" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;RouteDefinition&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;metodo: Verbo&lt;br&gt;patron: String&lt;br&gt;destino: ServiceTarget&lt;br&gt;rutaInterna: String&lt;br&gt;acceso: public|optional|session&lt;br&gt;limite: String&lt;hr size=&quot;1&quot;&gt;+coincide(metodo, ruta): Params" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#E1D5E7;strokeColor=#7A5C99;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="162" width="177" height="115" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AuthenticationPolicy&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;cookie: session_token&lt;br&gt;expiracion: 900 s&lt;hr size=&quot;1&quot;&gt;+autenticar(request): Identity&lt;br&gt;+descartarCabecerasDeIdentidad()" style="rounded=0;whiteSpa