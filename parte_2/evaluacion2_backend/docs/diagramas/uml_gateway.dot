digraph "uml_gateway" {
rankdir=TB; nodesep=0.55; ranksep=0.7; splines=true; compound=true;
node [shape=plaintext fontname="Helvetica" fontsize=10]; edge [fontname="Helvetica" fontsize=9 labeldistance=1.6];
"gw" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«gateway»</FONT><BR/><B>ApiGateway</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cookie: session_token  «HttpOnly, SameSite=Lax»<BR ALIGN="LEFT"/>maxBody: 64 KiB<BR ALIGN="LEFT"/>timeout: 3 s<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+handle(request): Response<BR ALIGN="LEFT"/>+login() / logout() / register() / me()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"route" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><B>RouteDefinition</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">metodo: Verbo<BR ALIGN="LEFT"/>patron: String<BR ALIGN="LEFT"/>destino: ServiceTarget<BR ALIGN="LEFT"/>rutaInterna: String<BR ALIGN="LEFT"/>acceso: public|optional|session<BR ALIGN="LEFT"/>limite: String<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+coincide(metodo, ruta): Params<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"authn" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><B>AuthenticationPolicy</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cookie: session_token<BR ALIGN="LEFT"/>expiracion: 900 s<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+autenticar(request): Identity<BR ALIGN="LEFT"/>+descartarCabecerasDeIdentidad()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"authz" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><B>AuthorizationPolicy</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">roles: Set&lt;Rol&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+permite(identity, ruta): Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"limit" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><B>RateLimiter</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">bucket: login|register|webhook|graphql|default<BR ALIGN="LEFT"/>ventana: 60 s<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+permitir(bucket, ip): Boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"target" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#4F8A3B"><TR><TD BGCOLOR="#D5E8D4" ALIGN="CENTER"><B>ServiceTarget</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre: String<BR ALIGN="LEFT"/>baseUrl: String<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+request(metodo, ruta, usuario): Response<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"secret" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#C77700"><TR><TD BGCOLOR="#FFE6CC" ALIGN="CENTER"><B>SecretProvider</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ttl: 30 s<BR ALIGN="LEFT"/>cache: Map<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+get(ruta): Map<BR ALIGN="LEFT"/>«fail-closed»<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"vault" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#C77700"><TR><TD BGCOLOR="#FFE6CC" ALIGN="CENTER"><FONT POINT-SIZE="8">«externo»</FONT><BR/><B>VaultClient</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">addr: String<BR ALIGN="LEFT"/>token: archivo montado ro<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+read(ruta) / write(ruta)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"auth" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«servicio privado»</FONT><BR/><B>AuthService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+login / register / introspect / logout<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"guard" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><FONT POINT-SIZE="8">«en cada servicio privado»</FONT><BR/><B>ServiceGuard</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">permitidos: Set&lt;Llamador&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+verificar(llamador, token): Caller<BR ALIGN="LEFT"/>acepta token vigente o anterior<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"gql" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«gateway privado»</FONT><BR/><B>GraphQLGateway</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">maxDepth: 6<BR ALIGN="LEFT"/>maxCost: 5000<BR ALIGN="LEFT"/>maxPage: 50<BR ALIGN="LEFT"/>introspeccion: off<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+execute(query, contexto): Result<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"schema" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><B>Schema</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Query: me, products, product, myOrders, order, salesSummary<BR ALIGN="LEFT"/>Mutation: createOrder, syncAnalytics<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"resolver" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#4F8A3B"><TR><TD BGCOLOR="#D5E8D4" ALIGN="CENTER"><B>Resolver</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">permisos: IsStaff|IsAdmin|CanPay|OwnerOrAdmin<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+resolver(campo, fuente, contexto)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"loader" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#4F8A3B"><TR><TD BGCOLOR="#D5E8D4" ALIGN="CENTER"><B>DataLoader</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">productos<BR ALIGN="LEFT"/>clientes<BR ALIGN="LEFT"/>pagos<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+load(clave) / lote por solicitud<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"limits" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A5C99"><TR><TD BGCOLOR="#E1D5E7" ALIGN="CENTER"><FONT POINT-SIZE="8">«regla de validacion»</FONT><BR/><B>CostLimit / DepthLimit</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+validar(documento): Error?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"grpc" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#4F8A3B"><TR><TD BGCOLOR="#D5E8D4" ALIGN="CENTER"><FONT POINT-SIZE="8">«cliente gRPC»</FONT><BR/><B>AnalyticsClient</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">canal: insecure (red privada)<BR ALIGN="LEFT"/>plazo: 5 s / 30 s<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+summary() / sync() / streamSales()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ana" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«servicio gRPC»</FONT><BR/><B>AnalyticsServer</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">interceptor: AuthInterceptor<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+SalesSummary (unary)<BR ALIGN="LEFT"/>+StreamSales (server streaming)<BR ALIGN="LEFT"/>+Sync (unary)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"priv" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3B6EA8"><TR><TD BGCOLOR="#DAE8FC" ALIGN="CENTER"><FONT POINT-SIZE="8">«servicios privados»</FONT><BR/><B>InventoryService, ClientService, OrderService, PaymentService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">REST con X-Service-Caller / X-Service-Token + identidad verificada<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"gw" -> "route" [label="define", taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond, arrowhead=none];
"route" -> "target" [label="enruta a", taillabel="0..*", headlabel="1", arrowhead=none];
"route" -> "authz" [label="exige", taillabel="0..*", headlabel="1", arrowhead=none];
"gw" -> "authn" [label="aplica", taillabel="1", headlabel="1", dir=both, arrowtail=diamond, arrowhead=none];
"gw" -> "limit" [label="aplica", taillabel="1", headlabel="1", dir=both, arrowtail=diamond, arrowhead=none];
"target" -> "secret" [label="credencial de arista", style=dashed, arrowhead=vee];
"secret" -> "vault" [label="lee de", taillabel="1", headlabel="1", arrowhead=none];
"authn" -> "auth" [label="introspect", style=dashed, arrowhead=vee];
"target" -> "priv" [label="REST privado", arrowhead=normal];
"priv" -> "guard" [label="protegido por", taillabel="1", headlabel="1", dir=both, arrowtail=diamond, arrowhead=none];
"gw" -> "gql" [label="POST /graphql", arrowhead=normal];
"gql" -> "schema" [label="expone", taillabel="1", headlabel="1", dir=both, arrowtail=diamond, arrowhead=none];
"schema" -> "resolver" [label="resuelve con", taillabel="1", headlabel="1..*", arrowhead=none];
"gql" -> "limits" [label="valida con", taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond, arrowhead=none];
"resolver" -> "loader" [style=dashed, arrowhead=vee];
"loader" -> "priv" [label="lotes", arrowhead=normal];
"resolver" -> "grpc" [style=dashed, arrowhead=vee];
"grpc" -> "ana" [label="gRPC", color="#4F8A3B", fontcolor="#4F8A3B", penwidth=2, arrowhead=normal];
}